# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Community Cloud > App settings > Secrets.
# Never commit the real file.

# Required for the AI features (create a key at https://openrouter.ai/keys). Without it the app runs in rule-based mode.
OPENROUTER_API_KEY = "sk-or-v1-..."

# Optional: any OpenRouter model slug that supports tool calling (see https://openrouter.ai/models).
# OPENROUTER_MODEL = "anthropic/claude-sonnet-5.5"

# Optional: your site URL, sent to OpenRouter as the HTTP-Referer header (used for their rankings).
# OPENROUTER_REFERER = "https://your-app.streamlit.app"

# Optional: Apify token for the public Instagram numbers (https://console.apify.com/settings/integrations).
# Live runs spend credits and always ask for confirmation in the app; importing finished runs is free.
# APIFY_TOKEN = "apify_api_..."
# Optional: IDs of the two saved Apify tasks that the monthly schedule runs (see the Data sources page).
# APIFY_PROFILE_TASK = "..."
# APIFY_REEL_TASK = "..."

# Meta Instagram API: "mock" (default, demo) or "live" (needs Meta app review and a token per creator).
# META_MODE = "mock"
